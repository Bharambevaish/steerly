{
  "name": "steerly",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "admin": "npm run dev -w steerly-admin",
    "mobile": "npm run start -w steerly-student",
    "build:admin": "npm run build -w steerly-admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "set-role": "node scripts/set-role.mjs",
    "web": "npm run dev -w steerly-web",
    "build:functions": "npm run build -w steerly-functions",
    "test": "npm run test --workspaces --if-present",
    "emulators": "npm run build:functions && firebase emulators:start --project demo-steerly --only auth,functions,firestore,storage",
    "e2e": "node scripts/e2e.mjs",
    "admin:emulator": "npm run dev:emulator -w steerly-admin",
    "brand": "node scripts/brand/generate.mjs",
    "seed": "node scripts/seed.mjs",
    "web:emulator": "npm run dev:emulator -w steerly-web",
    "create-school": "node scripts/create-school.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "expo-router": "^57.0.28",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0"
  },
  "overrides": {
    "react-server-dom-webpack": "19.2.3"
  }
}

{
  "name": "steerly",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "admin": "npm run dev -w steerly-admin",
    "mobile": "npm run start -w steerly-student",
    "build:admin": "npm run build -w steerly-admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "set-role": "node scripts/set-role.mjs",
    "web": "npm run dev -w steerly-web",
    "build:functions": "npm run build -w steerly-functions",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "firebase-admin": "^14.5.0"
  }
}

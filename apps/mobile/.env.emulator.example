# Run the app against the local Firebase emulators (auth, firestore, functions, storage).
#
# Expo only auto-loads .env, .env.local, .env.development(.local), .env.production(.local) — not this
# file. To use it:
#   1. From the repo root start the emulators:   npm run emulators   (project "demo-steerly")
#   2. Back up your real config, then copy this file over it:
#        cp .env.local .env.local.cloud      (optional backup)
#        cp .env.emulator.example .env.local
#   3. Restart Metro with a clean cache:       npx expo start -c   (press w for web, a for Android)
#   4. To go back to the real project, restore .env.local (or delete it and copy .env.example).
#
# OTP in the emulator: requestOtp runs in dev mode and the login screen shows the code in a banner.

EXPO_PUBLIC_USE_EMULATORS=true

# Must match the emulator project id (root package.json: --project demo-steerly).
# "demo-" projects need no real API key; any non-empty value works.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-steerly.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-steerly
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-steerly.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo

# Emulator host. Leave empty for the defaults: 10.0.2.2 on the Android emulator, 127.0.0.1 for
# web / iOS simulator. On a physical phone use your PC's LAN IP (and start the emulators with
# host 0.0.0.0 in firebase.json, plus allow the ports through Windows Firewall).
EXPO_PUBLIC_EMULATOR_HOST=

# Optional: lock to the seeded school so you skip the school picker.
EXPO_PUBLIC_SCHOOL_ID=
EXPO_PUBLIC_APP_NAME=Steerly

# Copy to .env.local and fill in from Firebase console → Project settings → Your apps (Web).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# White-label (optional). Leave EXPO_PUBLIC_SCHOOL_ID empty for the multi-school Steerly app.
EXPO_PUBLIC_APP_NAME=Steerly
EXPO_PUBLIC_SCHOOL_ID=
# Where owners/staff are sent from the app.
EXPO_PUBLIC_ADMIN_URL=https://admin.steerly.app
# Build-time only (read by app.config.ts): EAS project for push tokens, per-school store ids.
EAS_PROJECT_ID=
APP_SLUG=
APP_BUNDLE_ID=
APP_BRAND_COLOR=
APP_ICON=

# Local Firebase emulators: see .env.emulator.example.
EXPO_PUBLIC_USE_EMULATORS=false

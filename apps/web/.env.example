# Copy to .env.local and fill in. Same Firebase web app config as apps/admin.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: reCAPTCHA v3 site key for Firebase App Check (recommended once the enquiry form is live).
VITE_APPCHECK_RECAPTCHA_SITE_KEY=

# Where "Start free trial" sends new schools (admin dashboard signup).
VITE_ADMIN_URL=http://localhost:5173
# Google Play listing for the Steerly student/instructor app.
VITE_PLAY_STORE_URL=
# Set to true to read from the local Firestore emulator (see .env.emulator / npm run web:emulator).
VITE_USE_EMULATORS=false

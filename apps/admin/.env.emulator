# Used by `npm run admin:emulator` (vite --mode emulator). Talks only to the local emulators
# started with `npm run emulators`; the demo project id never reaches real Firebase.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-steerly.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-steerly
VITE_FIREBASE_STORAGE_BUCKET=demo-steerly.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
VITE_APPCHECK_RECAPTCHA_SITE_KEY=
VITE_USE_EMULATORS=true
VITE_PUBLIC_SITE_URL=http://localhost:5174

# Copy to functions/.env.<projectId> (e.g. .env.steerly-dev). Secrets go in Secret Manager instead:
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
#   firebase functions:secrets:set MSG91_AUTH_KEY
#   firebase functions:secrets:set AISENSY_API_KEY   (required at deploy even if WhatsApp is off; any value)
RAZORPAY_KEY_ID=
MSG91_TEMPLATE_ID=
# true = don't send SMS, return the OTP in the response (emulator / testing only)
OTP_DEV_MODE=true
# Phone numbers (10 digits, comma-separated) that always accept OTP 123456, for store reviewers.
OTP_TEST_NUMBERS=
PUBLIC_WEB_URL=http://localhost:5174
# Razorpay subscription plan ids (create the 3 plans in Razorpay → Subscriptions → Plans)
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_WHITELABEL=
# WhatsApp via AiSensy (optional). true = also send WhatsApp template messages.
WHATSAPP_ENABLED=false
# AiSensy campaign names (one API campaign per approved template)
WHATSAPP_CAMPAIGN_LESSON_REMINDER=
WHATSAPP_CAMPAIGN_PAYMENT_LINK=
WHATSAPP_CAMPAIGN_RECEIPT=

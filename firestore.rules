rules_version = '2';

// Multi-tenant rules. Every user's ID token carries custom claims set by Cloud Functions:
//   role:      superAdmin | owner | staff | instructor | student
//   schoolId:  the school they belong to (absent for superAdmin)
//   studentId: their student doc id (students only)
// Anything that moves money, assigns roles or books slots is done by Cloud Functions
// (Admin SDK bypasses these rules). Clients only get the direct access listed here.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function claims() { return request.auth.token; }
    function role() { return signedIn() ? claims().get('role', '') : ''; }
    function isSuperAdmin() { return role() == 'superAdmin'; }
    function inSchool(schoolId) {
      return isSuperAdmin() || (signedIn() && claims().get('schoolId', '') == schoolId);
    }
    function isOwner(schoolId) { return isSuperAdmin() || (inSchool(schoolId) && role() == 'owner'); }
    function isAdmin(schoolId) { return isSuperAdmin() || (inSchool(schoolId) && role() in ['owner', 'staff']); }
    function isStaffOrInstructor(schoolId) {
      return isAdmin(schoolId) || (inSchool(schoolId) && role() == 'instructor');
    }
    function isInstructor(schoolId) { return inSchool(schoolId) && role() == 'instructor'; }
    function isStudent(schoolId) { return inSchool(schoolId) && role() == 'student'; }
    function myStudentId() { return claims().get('studentId', ''); }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function schoolActive(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data.subscription.status
        in ['trial', 'active', 'past_due'];
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      // Users may only update their display name and push token. Everything else is set by functions.
      allow update: if signedIn() && request.auth.uid == uid && onlyChanges(['name', 'expoPushToken']);

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid && onlyChanges(['read']);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Public lookup of join codes (contains only schoolId + name).
    match /schoolCodes/{code} {
      allow get: if true;
    }

    // Public lookup of web slugs (contains only schoolId + name).
    match /schoolSlugs/{slug} {
      allow get: if true;
    }

    // ---------- schools ----------
    match /schools/{schoolId} {
      // Public: school profile (name, logo, colour) is needed by the public enquiry form and app branding.
      allow get: if true;
      allow list: if isSuperAdmin();
      // Owners edit the profile and settings; plan/status/code/owner are function-only.
      allow update: if isOwner(schoolId)
        && onlyChanges(['name', 'logoUrl', 'brandColor', 'phone', 'email', 'address', 'city', 'settings'])
        && validSchoolProfile(request.resource.data);

      match /members/{uid} {
        allow read: if isStaffOrInstructor(schoolId);
        // Owners can edit a member's display name/phone and "also teaches"; role & active go through updateMember.
        allow update: if isOwner(schoolId) && onlyChanges(['name', 'phone', 'email', 'teaches']);
      }

      match /invites/{phone} {
        allow read: if isAdmin(schoolId);
        allow delete: if isOwner(schoolId);
      }

      match /branches/{branchId} {
        allow read: if inSchool(schoolId);
        allow create, update, delete: if isOwner(schoolId);
      }

      match /courses/{courseId} {
        // Public so prospective students can browse prices before signing up.
        allow read: if true;
        allow create, update, delete: if isAdmin(schoolId);
      }

      match /enquiries/{enquiryId} {
        allow create: if validNewEnquiry(request.resource.data) && schoolActive(schoolId);
        // Admins can log walk-in / phone / referral leads with notes and a follow-up date.
        allow create: if isAdmin(schoolId) && validAdminEnquiry(request.resource.data);
        allow read: if isAdmin(schoolId);
        allow update: if isAdmin(schoolId)
          && onlyChanges(['status', 'notes', 'followUpAt', 'updatedAt', 'courseId', 'courseName', 'preferredTime'])
          && request.resource.data.status in ['New', 'Contacted', 'Enrolled', 'Lost']
          && validLeadDetails(request.resource.data);
        allow delete: if isOwner(schoolId);
      }

      match /students/{studentId} {
        allow read: if isStaffOrInstructor(schoolId)
          || (isStudent(schoolId) && myStudentId() == studentId);
        // Admins manage the student record but never the money or link fields.
        allow update: if isAdmin(schoolId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['feePaid', 'uid', 'id', 'createdAt', 'referralCode']);
        // Students can edit their own contact details only.
        allow update: if isStudent(schoolId) && myStudentId() == studentId
          && onlyChanges(['email', 'address', 'dob']);
        allow delete: if isOwner(schoolId);

        match /documents/{docId} {
          allow read: if isStaffOrInstructor(schoolId)
            || (isStudent(schoolId) && myStudentId() == studentId);
          allow create: if (isAdmin(schoolId) || (isStudent(schoolId) && myStudentId() == studentId))
            && request.resource.data.verified == false
            && request.resource.data.uploadedBy == request.auth.uid
            && validStudentDocument(request.resource.data, schoolId, studentId);
          allow update: if isAdmin(schoolId) && onlyChanges(['verified', 'type'])
            && request.resource.data.type in DOCUMENT_TYPES()
            && request.resource.data.verified is bool;
          allow delete: if isAdmin(schoolId)
            || (isStudent(schoolId) && myStudentId() == studentId && resource.data.verified == false);
        }
      }

      match /vehicles/{vehicleId} {
        allow read: if isStaffOrInstructor(schoolId);
        allow create, update, delete: if isAdmin(schoolId);
      }

      match /availability/{instructorId} {
        allow read: if isStaffOrInstructor(schoolId);
        allow write: if isAdmin(schoolId) || (isInstructor(schoolId) && request.auth.uid == instructorId);
      }

      match /slots/{slotId} {
        allow read: if inSchool(schoolId);
        // Admins/instructors may block or unblock open slots directly. Booking is function-only.
        allow update: if (isAdmin(schoolId) || (isInstructor(schoolId) && resource.data.instructorId == request.auth.uid))
          && onlyChanges(['status'])
          && resource.data.status in ['open', 'blocked']
          && request.resource.data.status in ['open', 'blocked'];
        allow delete: if isAdmin(schoolId) && resource.data.status != 'booked';
      }

      match /bookings/{bookingId} {
        allow read: if isAdmin(schoolId)
          || (isInstructor(schoolId) && resource.data.instructorId == request.auth.uid)
          || (isStudent(schoolId) && resource.data.studentId == myStudentId());
      }

      match /payments/{paymentId} {
        allow read: if isAdmin(schoolId)
          || (isStudent(schoolId) && resource.data.studentId == myStudentId());
      }

      // counters are function-only (no client access)
    }

    // Must stay in sync with enquiryInputSchema in packages/shared/src/enquiry.ts
    function validNewEnquiry(d) {
      return d.keys().hasOnly(['name', 'phone', 'courseId', 'courseName', 'preferredTime', 'source',
                               'status', 'notes', 'followUpAt', 'studentId', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && safeText(d.name)
        && d.phone is string && d.phone.matches('^[6-9][0-9]{9}$')
        && (d.courseId == null || (d.courseId is string && d.courseId.size() <= 64))
        && d.courseName is string && d.courseName.size() > 0 && d.courseName.size() <= 80
        && d.preferredTime in ['Morning', 'Afternoon', 'Evening', 'Flexible']
        && d.source in ['app', 'web']
        && d.status == 'New'
        && d.get('notes', '') == ''
        && d.get('followUpAt', null) == null
        && d.get('studentId', null) == null
        && d.get('updatedAt', null) == null
        && d.createdAt == request.time;
    }

    function validAdminEnquiry(d) {
      return d.keys().hasOnly(['name', 'phone', 'courseId', 'courseName', 'preferredTime', 'source',
                               'status', 'notes', 'followUpAt', 'studentId', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.phone is string && d.phone.matches('^[6-9][0-9]{9}$')
        && d.courseName is string && d.courseName.size() <= 80
        && d.source in ['app', 'web', 'walk_in', 'phone', 'referral']
        && d.status in ['New', 'Contacted', 'Lost']
        && d.get('studentId', null) == null
        && validLeadDetails(d)
        && d.createdAt == request.time;
    }

    // Text that a spreadsheet would treat as a formula when exported to CSV (see SECURITY_REVIEW M1).
    function safeText(t) {
      return !t.matches('^[=+@\t\r-].*');
    }

    function validLeadDetails(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80 && safeText(d.name)
        && d.preferredTime in ['Morning', 'Afternoon', 'Evening', 'Flexible']
        && (d.get('courseName', '') is string && d.get('courseName', '').size() <= 80)
        && (d.get('courseId', null) == null || (d.courseId is string && d.courseId.size() <= 64))
        && (d.get('notes', '') is string && d.get('notes', '').size() <= 2000)
        && (d.get('followUpAt', null) == null || d.followUpAt is timestamp);
    }

    function DOCUMENT_TYPES() {
      return ['photo', 'id_proof', 'address_proof', 'medical', 'learner_licence', 'driving_licence', 'other'];
    }

    // A document record may only point at that student's own Storage folder.
    function validStudentDocument(d, schoolId, studentId) {
      return d.type in DOCUMENT_TYPES()
        && d.fileName is string && d.fileName.size() > 0 && d.fileName.size() <= 200
        && d.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif', 'application/pdf']
        && d.storagePath is string && d.storagePath.size() <= 400
        && d.storagePath.matches('^schools/' + schoolId + '/students/' + studentId + '/[^/]+$');
    }

    // Owner-editable school profile + settings (see SECURITY_REVIEW M3). Ranges match the Settings page.
    function validSchoolProfile(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.brandColor is string && d.brandColor.matches('^#[0-9A-Fa-f]{6}$')
        && (d.logoUrl == null
            || (d.logoUrl is string && d.logoUrl.size() <= 1000
                && d.logoUrl.matches('^(https://firebasestorage[.]googleapis[.]com/|http://(127[.]0[.]0[.]1|localhost):9199/).*')))
        && d.phone is string && d.phone.matches('^[0-9]{10}$')
        && (d.email == null || (d.email is string && d.email.size() <= 120))
        && d.address is string && d.address.size() <= 300
        && d.city is string && d.city.size() <= 60
        && validSettings(d.settings);
    }

    function validSettings(st) {
      return st.keys().hasOnly(['lessonMinutes', 'cancelBeforeHours', 'maxBookingsPerDay', 'bookingWindowDays',
                                'gstin', 'gstPercent', 'upiId', 'receiptPrefix'])
        && st.lessonMinutes is number && st.lessonMinutes >= 15 && st.lessonMinutes <= 240
        && st.cancelBeforeHours is number && st.cancelBeforeHours >= 0 && st.cancelBeforeHours <= 168
        && st.maxBookingsPerDay is number && st.maxBookingsPerDay >= 1 && st.maxBookingsPerDay <= 10
        && st.bookingWindowDays is number && st.bookingWindowDays >= 1 && st.bookingWindowDays <= 90
        && (st.gstin == null || (st.gstin is string && st.gstin.size() <= 20))
        && st.gstPercent in [0, 18]
        && (st.upiId == null || (st.upiId is string && st.upiId.size() <= 80))
        && st.receiptPrefix is string && st.receiptPrefix.matches('^[A-Z0-9]{2,6}$');
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
